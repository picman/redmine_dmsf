<% html_title l(:label_dmsf_onlyoffice_recovery) %>
<h2><%= l(:label_dmsf_onlyoffice_recovery) %> — <%= @file.title %></h2>
<p><%= l(:note_dmsf_onlyoffice_recovery) %></p>
<p><%= link_to l(:label_document), dmsf_file_path(@file) %></p>
<table class="list">
  <thead><tr><th>#</th><th><%= l(:field_created_on) %></th><th><%= l(:field_type) %></th><th><%= l(:field_filename) %></th><th><%= l(:field_status) %></th><th></th></tr></thead>
  <tbody>
    <% @recoveries.each do |recovery| %>
      <tr>
        <td><%= recovery.id %></td><td><%= format_time(recovery.created_at) %></td>
        <td><%= recovery.kind %></td><td><%= recovery.filename %></td>
        <td><%= recovery.state %><br><%= recovery.reason %></td>
        <td class="buttons">
          <% if recovery.payload.attached? %>
          <%= link_to l(:button_download), dmsf_onlyoffice_recovery_download_path(@file, recovery_id: recovery.id) %>
          <% unless recovery.restored_revision_id %>
            <%= button_to l(:label_dmsf_onlyoffice_save_copy), dmsf_onlyoffice_recovery_copy_path(@file, recovery_id: recovery.id), method: :post %>
            <% unless recovery.kind == 'form' %>
              <%= button_to l(:label_dmsf_onlyoffice_restore), dmsf_onlyoffice_recovery_restore_path(@file, recovery_id: recovery.id), method: :post,
                            params: { expected_revision_id: @file.last_revision.id }, data: { confirm: l(:text_are_you_sure) } %>
            <% end %>
          <% end %>
          <% elsif recovery.restored_revision&.visible? %>
            <%= link_to l(:label_document), dmsf_file_path(recovery.restored_revision.dmsf_file_id) %>
          <% end %>
        </td>
      </tr>
      <% if recovery.kind == 'form' && recovery.metadata['forms_data'].present? %>
        <tr><td colspan="6">
          <details><summary><%= l(:label_dmsf_onlyoffice_form_data) %></summary><pre><%= JSON.pretty_generate(recovery.metadata['forms_data']) %></pre></details>
          <p><%= l(:note_dmsf_onlyoffice_form_import) %></p>
          <%= form_tag dmsf_onlyoffice_recovery_form_preview_path(@file, recovery_id: recovery.id), method: :get do %>
            <%= label_tag "issue-#{recovery.id}", l(:label_issue) %>
            <%= number_field_tag :issue_id, nil, id: "issue-#{recovery.id}", min: 1, required: true %>
            <%= submit_tag l(:button_preview) %>
          <% end %>
        </td></tr>
      <% end %>
    <% end %>
  </tbody>
</table>
<p class="pagination">
  <%= link_to '←', dmsf_onlyoffice_recovery_path(@file, page: @page - 1), 'aria-label': l(:label_previous) if @page > 1 %>
  <%= @page %> / <%= [(@total.to_f / 50).ceil, 1].max %>
  <%= link_to '→', dmsf_onlyoffice_recovery_path(@file, page: @page + 1), 'aria-label': l(:label_next) if @page * 50 < @total %>
</p>
