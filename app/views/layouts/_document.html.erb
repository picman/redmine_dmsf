<div class="contextual">
  <%= link_to "#{l(:button_download)} (#{number_to_human_size(@dmsf_file.size)})",
              static_dmsf_file_path(@dmsf_file, download: @dmsf_file.last_revision,
                                    filename: @dmsf_file.last_revision.file&.blob&.filename),
              class: 'icon icon-download', disabled: false %>
</div>

<h2>
  <%= render partial: '/dmsf/path', locals: { folder: @dmsf_file.dmsf_folder, filename: @dmsf_file.title, title: nil } %>
</h2>

<div class="attachments">
  <p>
    <%= @dmsf_file.description %>
    <span class="author">
      <%= link_to_user @dmsf_file.last_revision.user %>, <%= format_time @dmsf_file.last_revision.updated_at %>
    </span>
  </p>
</div>
<div class="filecontent-container">
  <%= yield %>
</div>

<% html_title @dmsf_file.name %>

<% content_for :header_tags do %>
    <%= stylesheet_link_tag 'scm' %>
<% end %>
